SNOWFLAKE_ACCOUNT=zb45354.east-us-2.azure
SNOWFLAKE_USER=SVC_MCP_OAUTH
SNOWFLAKE_WAREHOUSE=WH_MCP_COMPUTE
SNOWFLAKE_DATABASE=PRD_EDW_STG
SNOWFLAKE_SCHEMA=UAM_MONITORING
SNOWFLAKE_ROLE=UAM_MCP_ROLE

# When true, dashboard SQL uses SEMANTIC_VIEW(...) against SV_* semantic views (aligned with Cortex).
# When false, legacy queries against MONITORING_EVENTS / CYCLE_STATUS_LOGS are used.
USE_SEMANTIC_VIEWS=false

# Cortex Analyst REST API (POST /api/cortex-analyst/message): required when using keypair Snowflake auth.
# Create a programmatic access token in Snowsight, or use SNOWFLAKE_AUTH_METHOD=oauth instead.
# SNOWFLAKE_CORTEX_PAT=
# Optional: override full Cortex endpoint URL if your account uses a non-standard host.
# SNOWFLAKE_CORTEX_API_URL=https://YOUR_ACCOUNT.snowflakecomputing.com/api/v2/cortex/analyst/message

# Auth method: "keypair" (default) or "oauth"
SNOWFLAKE_AUTH_METHOD=keypair

# Key Pair auth (used when SNOWFLAKE_AUTH_METHOD=keypair)
SNOWFLAKE_PRIVATE_KEY_PATH=snowflake_rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Azure AD Service Principal (used when SNOWFLAKE_AUTH_METHOD=oauth)
# AZURE_TENANT_ID=your-azure-tenant-id
# AZURE_CLIENT_ID=your-app-registration-client-id
# AZURE_CLIENT_SECRET=your-client-secret-value
# SNOWFLAKE_OAUTH_SCOPE=api://your-client-id/.default
